    // --- Default Healthcare Custom Rules ---
    const DEFAULT_RULES = [
      { id: 'r1', trigger: 'blood pressure', response: '🩺 **Blood Pressure Guide:**\n- **Normal:** Less than `120/80 mmHg`\n- **Elevated:** `120–129` systolic and less than `80` diastolic\n- **High (Hypertension):** `130/80 mmHg` or higher\n*Tip: Reduce sodium, stay active, and measure after resting quietly for 5 minutes.*' },
      { id: 'r2', trigger: 'emergency', response: '🚑 **Medical Emergency Warning:** If you or someone nearby experiences **chest pain, difficulty breathing, sudden numbness/weakness, severe bleeding, or loss of consciousness**, please call your local emergency number (**108 / 112 / 911**) or visit the nearest Emergency Room immediately.' },
      { id: 'r3', trigger: 'hydration', response: '💧 **Daily Hydration Guideline:** Most adults need roughly **2.5 to 3.5 liters (8–12 cups)** of water per day, or about `35 ml per kg of body weight`—and more during hot weather or exercise!' }
    ];
    // --- Healthcare Guardrail Keyword Classifier ---
    const HEALTH_KEYWORDS = [
      'health', 'medical', 'doctor', 'clinic', 'hospital', 'nurse', 'patient', 'symptom', 'pain', 'ache',
      'fever', 'cold', 'flu', 'cough', 'throat', 'headache', 'migraine', 'stomach', 'nausea', 'dizzy',
      'allergy', 'rash', 'skin', 'burn', 'cut', 'bleed', 'sprain', 'fracture', 'injury', 'first aid', 'rice',
      'blood', 'pressure', 'heart', 'pulse', 'cholesterol', 'diabetes', 'insulin', 'sugar', 'glucose',
      'bmi', 'weight', 'height', 'kg', 'cm', 'calorie', 'diet', 'nutrition', 'food', 'meal', 'protein',
      'carb', 'fat', 'fiber', 'vitamin', 'mineral', 'iron', 'calcium', 'water', 'hydrat', 'dehydrat',
      'sleep', 'insomnia', 'rest', 'nap', 'stress', 'anxiety', 'mental', 'mindful', 'breath', 'meditat',
      'exercise', 'workout', 'fitness', 'stretch', 'muscle', 'joint', 'back', 'neck', 'eye', 'strain',

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MediBot Care — Healthcare-Only AI Chatbot App</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.3); border-radius: 9999px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(148, 163, 184, 0.5); }
    @keyframes bounceDot {
      0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
      40% { transform: translateY(-5px); opacity: 1; }
    }
    .typing-dot-1 { animation: bounceDot 1.2s infinite ease-in-out 0s; }
    .typing-dot-2 { animation: bounceDot 1.2s infinite ease-in-out 0.2s; }
    .typing-dot-3 { animation: bounceDot 1.2s infinite ease-in-out 0.4s; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 h-screen w-full overflow-hidden select-none sm:select-auto transition-colors duration-200">
  <div class="flex h-full w-full relative">
    <!-- Mobile Backdrop -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-20 hidden lg:hidden"></div>
    <!-- Left Sidebar: Conversations & Modes -->
    <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-30 w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out">
      <!-- Brand Header -->
      <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-violet-500 to-fuchsia-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
          </div>
          <div>
            <h1 class="font-bold text-base tracking-tight leading-none">MediBot Care</h1>
            <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">Healthcare-Only AI</span>
          </div>
        </div>
        <button id="closeSidebarBtn" class="lg:hidden p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" title="Close Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <!-- New Chat Button -->
      <div class="p-3">
        <button id="newChatBtn" class="w-full py-2.5 px-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium text-sm flex items-center justify-center gap-2 shadow-sm transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          <span>New Conversation</span>
        </button>
      </div>
      <!-- Search Filter -->
      <div class="px-3 pb-2">
        <div class="relative">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M16.65 10.825a5.825 5.825 0 11-11.65 0 5.825 5.825 0 0111.65 0z"/>
          </svg>
          <input id="searchChatsInput" type="text" placeholder="Filter chats..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-transparent focus:border-indigo-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none transition" />
        </div>
      </div>
      <!-- Conversation List -->
      <div class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 flex items-center justify-between">
        <span>Conversations</span>
        <span id="chatCountBadge" class="px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">1</span>
      </div>
      <div id="chatListContainer" class="flex-1 overflow-y-auto custom-scrollbar px-2 space-y-1"></div>
      <!-- Bot Customizer & Settings Footer -->
      <div class="p-3 border-t border-slate-200 dark:border-slate-800 space-y-1.5 bg-slate-50/50 dark:bg-slate-900/50">
        <button id="openTrainModalBtn" class="w-full px-3 py-2 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-800 flex items-center justify-between transition">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
            Train Custom Responses
          </span>
          <span id="customRulesCount" class="px-1.5 py-0.5 text-[10px] rounded-full bg-violet-500/10 text-violet-600 dark:text-violet-400 font-semibold">3</span>
        </button>
        <button id="openApiModalBtn" class="w-full px-3 py-2 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-800 flex items-center justify-between transition">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
            Engine &amp; API Key
          </span>
          <span id="engineStatusBadge" class="px-1.5 py-0.5 text-[10px] rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">Built-in AI</span>
        </button>
      </div>
    </aside>
    <!-- Main Chat Area -->
    <main class="flex-1 flex flex-col h-full min-w-0 bg-white dark:bg-slate-950">
      <!-- Top Navigation Bar -->
      <header class="h-16 px-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-2 shrink-0 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md z-10">
        <div class="flex items-center gap-2.5 min-w-0">
          <button id="openSidebarBtn" class="lg:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800" title="Open Menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <!-- Persona Selector -->
          <div class="flex items-center gap-2 min-w-0">
            <div id="activePersonaIcon" class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-base shrink-0">🤖</div>
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <label for="personaSelect" class="sr-only">Choose Bot Persona</label>
                <select id="personaSelect" class="bg-transparent font-semibold text-sm text-slate-900 dark:text-slate-100 focus:outline-none cursor-pointer pr-1 truncate">
                  <option value="assistant" class="bg-white dark:bg-slate-900">Dr. Nova — General Healthcare Guide</option>
                  <option value="coder" class="bg-white dark:bg-slate-900">NutriBot — Nutrition &amp; Diet Guide</option>
                  <option value="tutor" class="bg-white dark:bg-slate-900">MedTutor — Anatomy &amp; Health Quiz</option>
                  <option value="creative" class="bg-white dark:bg-slate-900">MindCare — Sleep &amp; Stress Coach</option>
                  <option value="support" class="bg-white dark:bg-slate-900">ClinicCare — First-Aid &amp; Patient Help</option>
                </select>
              </div>
              <p id="personaSubtitle" class="text-[11px] text-slate-500 dark:text-slate-400 truncate">Strictly healthcare, symptoms, wellness &amp; medical education only</p>
            </div>
          </div>
        </div>
        <!-- Top Right Controls -->
        <div class="flex items-center gap-1.5 shrink-0">
          <button id="voiceToggleBtn" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Toggle Voice Read-Aloud (TTS)">
            <svg id="voiceOnIcon" class="w-4 h-4 hidden text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
            </svg>
            <svg id="voiceOffIcon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
            </svg>
          </button>
          <button id="exportChatBtn" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Export Chat Transcript">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
          </button>
          <button id="clearChatBtn" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Clear Current Messages">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
          <button id="themeToggleBtn" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Toggle Light/Dark Mode">
            <svg id="sunIcon" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg id="moonIcon" class="w-4 h-4 block dark:hidden text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>
        </div>
      </header>
      <!-- Messages Stream -->
      <div id="messagesContainer" class="flex-1 overflow-y-auto custom-scrollbar px-4 py-6 space-y-5">
        <!-- Populated dynamically by JS -->
      </div>
      <!-- Quick Suggestion Chips -->
      <div class="px-4 pt-1 pb-2 border-t border-slate-100 dark:border-slate-900 bg-white dark:bg-slate-950">
        <div class="max-w-3xl mx-auto">
          <div id="quickPromptsBar" class="flex items-center gap-2 overflow-x-auto custom-scrollbar py-1"></div>
        </div>
      </div>
      <!-- Input Composer -->
      <div class="px-4 pb-4 pt-1 bg-white dark:bg-slate-950 shrink-0">
        <div class="max-w-3xl mx-auto">
          <form id="chatForm" class="relative rounded-2xl border border-slate-300 dark:border-slate-700/80 bg-slate-50 dark:bg-slate-900 focus-within:border-indigo-500 dark:focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/20 transition shadow-sm">
            <textarea
              id="messageInput"
              rows="1"
              placeholder="Ask a healthcare, symptom, nutrition, or wellness question... (Healthcare topics only)"
              class="w-full bg-transparent px-4 pt-3 pb-11 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none resize-none max-h-36 custom-scrollbar"
            ></textarea>
            <div class="absolute bottom-2 left-3 right-3 flex items-center justify-between">
              <div class="flex items-center gap-1">
                <button type="button" id="insertMathBtn" class="px-2 py-1 rounded-md text-xs text-slate-500 dark:text-slate-400 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition" title="Try a calculation">
                  🧮 Calc
                </button>
                <button type="button" id="insertCodeBtn" class="px-2 py-1 rounded-md text-xs text-slate-500 dark:text-slate-400 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition" title="Generate code sample">
                  💻 Code
                </button>
                <button type="button" id="insertQuizBtn" class="px-2 py-1 rounded-md text-xs text-slate-500 dark:text-slate-400 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition" title="Start a quick trivia question">
                  🎯 Quiz Me
                </button>
              </div>
              <div class="flex items-center gap-2">
                <span id="charCounter" class="text-[11px] text-slate-400 dark:text-slate-500">0 chars</span>
                <button
                  type="submit"
                  id="sendBtn"
                  class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-xs font-semibold flex items-center gap-1.5 shadow-sm transition disabled:opacity-40"
                >
                  <span>Send</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  <!-- Modal 1: Train Custom Bot Responses -->
  <div id="trainModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
      <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="font-bold text-base">Train Custom Bot Triggers</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Teach your chatbot custom keyword rules and instant replies</p>
        </div>
        <button id="closeTrainModalBtn" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="p-5 overflow-y-auto custom-scrollbar space-y-4 flex-1">
        <form id="addRuleForm" class="space-y-3 bg-slate-50 dark:bg-slate-800/50 p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800">
          <div>
            <label for="ruleTriggerInput" class="block text-xs font-semibold mb-1 text-slate-700 dark:text-slate-300">When user message contains keyword/phrase:</label>
            <input id="ruleTriggerInput" type="text" required placeholder="e.g. blood pressure, clinic hours, allergy tips" class="w-full px-3 py-2 text-xs rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 focus:border-indigo-500 focus:outline-none" />
          </div>
          <div>
            <label for="ruleResponseInput" class="block text-xs font-semibold mb-1 text-slate-700 dark:text-slate-300">Bot replies with:</label>
            <textarea id="ruleResponseInput" rows="2" required placeholder="e.g. Normal resting adult blood pressure is typically below 120/80 mmHg." class="w-full px-3 py-2 text-xs rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 focus:border-indigo-500 focus:outline-none resize-none"></textarea>
          </div>
          <button type="submit" class="w-full py-2 rounded-lg bg-violet-600 hover:bg-violet-500 text-white font-semibold text-xs transition">
            + Add Custom Rule
          </button>
        </form>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Active Custom Rules</h3>
          <div id="customRulesList" class="space-y-2"></div>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal 2: Engine & Live API Key Settings -->
  <div id="apiModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full shadow-2xl overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="font-bold text-base">AI Engine &amp; API Connection</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Use the built-in smart engine or connect a live Gemini API key</p>
        </div>
        <button id="closeApiModalBtn" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <form id="apiSettingsForm" class="p-5 space-y-4">
        <div>
          <label for="botNameInput" class="block text-xs font-semibold mb-1 text-slate-700 dark:text-slate-300">Your Name (so the bot remembers you)</label>
          <input id="botNameInput" type="text" placeholder="e.g. Alex" class="w-full px-3 py-2 text-xs rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 focus:border-indigo-500 focus:outline-none" />
        </div>
        <div>
          <label for="geminiKeyInput" class="block text-xs font-semibold mb-1 text-slate-700 dark:text-slate-300">Optional Google Gemini API Key</label>
          <input id="geminiKeyInput" type="password" placeholder="AIzaSy... (Leave blank for Built-in Smart Engine)" class="w-full px-3 py-2 text-xs rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 focus:border-indigo-500 focus:outline-none font-mono" />
          <p class="mt-1.5 text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
            When blank, NovaBot uses its built-in offline engine (math solver, code generator, quiz master, custom rules &amp; persona responses). If you paste a Gemini key, it calls <code class="font-mono text-indigo-500">gemini-2.5-flash</code> directly from your browser.
          </p>
        </div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="cancelApiModalBtn" class="px-4 py-2 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white">Save Settings</button>
        </div>
      </form>
    </div>
  </div>
  <!-- Toast Notification -->
  <div id="toastBanner" class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium shadow-lg transform translate-y-16 opacity-0 pointer-events-none transition-all duration-200">
    Notification
  </div>
  <script>
    // --- Safe Storage Helper ---
    const Storage = {
      get(key, fallback) {
        try {
          const raw = localStorage.getItem(key);
          return raw ? JSON.parse(raw) : fallback;
        } catch (e) {
          return fallback;
        }
      },
      set(key, val) {
        try {
          localStorage.setItem(key, JSON.stringify(val));
        } catch (e) {
          // ignore storage quota/sandbox blocks
        }
      }
    };
    // --- Persona Definitions (Healthcare-Only Modes) ---
    const PERSONAS = {
      assistant: {
        name: 'Dr. Nova (Health Guide)',
        icon: '🩺',
        subtitle: 'Strictly healthcare, symptoms, preventive care & BMI/wellness metrics',
        greeting: "Hello! I'm **Dr. Nova**, your dedicated **Healthcare-Only AI Assistant**. I strictly answer questions related to health, symptoms, nutrition, fitness, first aid, and mental wellness—and I automatically decline non-healthcare topics.\n\n*Disclaimer: Educational information only, not a substitute for professional medical advice.* How can I support your health today?",
        prompts: [
          'What are common remedies for a sore throat and mild fever?',
          'Calculate BMI for 70 kg and 175 cm',
          'How much water should I drink daily?',
          'Signs of dehydration to watch for'
        ]
